# ========== REQUIRED ==========
# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram → create bot with @BotFather, then paste token + username (without @)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_BOT_USERNAME=YourBotName
# Your numeric chat id (message the bot once, then open:
# https://api.telegram.org/bot<TOKEN>/getUpdates  → look for "chat":{"id": ...)
TELEGRAM_CHAT_ID=your_numeric_chat_id

# ========== OPTIONAL (owner LinkedIn auto-post) ==========
# LinkedIn Developer App → OAuth 2.0 access token with w_member_social
# Person URN looks like: urn:li:person:AbCdEf123
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# ========== OPTIONAL WhatsApp preview (Twilio) ==========
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
USER_WHATSAPP_NUMBER=whatsapp:+91XXXXXXXXXX

# ========== RUNTIME ==========
TELEGRAM_POLLING=1
PORT=8000
# USERS_DIR=data/users
