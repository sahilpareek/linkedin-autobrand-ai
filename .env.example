# ==========================================
# 1. Google Gemini API (For AI Post Generation)
# Get your key here: https://aistudio.google.com/
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# 2. LinkedIn API Settings
# Get from: https://www.linkedin.com/developers/
# ==========================================
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_PERSON_URN=urn:li:person:YOUR_URN_ID_HERE

# ==========================================
# 3. WhatsApp Integration (Twilio Sandbox)
# Free setup: https://www.twilio.com/console
# ==========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
USER_WHATSAPP_NUMBER=whatsapp:+91XXXXXXXXXX
