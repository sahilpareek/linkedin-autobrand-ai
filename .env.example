# ==========================================
# 1. Google Gemini API (For AI Post & Skill Generation)
# Get your free key here: https://aistudio.google.com/
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# 2. WhatsApp Twilio Sandbox / Account
# Get from: https://www.twilio.com/console
# ==========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ADMIN WhatsApp Number (Aapka WhatsApp number jahan naye users ka alert aayega)
ADMIN_WHATSAPP_NUMBER=whatsapp:+91XXXXXXXXXX

# ==========================================
# 3. Default / Fallback LinkedIn Credentials (Optional)
# ==========================================
DEFAULT_LINKEDIN_ACCESS_TOKEN=your_token_here
DEFAULT_LINKEDIN_PERSON_URN=urn:li:person:YOUR_URN_HERE

# ==========================================
# 4. Server Port & Domain
# ==========================================
PORT=8000
BASE_URL=http://localhost:8000
